{
  // ===== 合并选项 =====
  // stripRuleMeta: true = 去掉规则的快照链接(snapshotUrls/exampleUrls), 产物体积约减小 15%,
  //                代价是 GKD 里看不到规则的快照截图; 默认 false(保留)
  stripRuleMeta: false,

  // ===== GKD 订阅源配置 =====
  // 增删订阅只需要改这个文件，然后重新运行合并即可
  // 每一项: id=唯一标识(英文), name=显示名, enabled=是否启用
  //         url=主地址, fallbacks=备用镜像地址(主地址失败时依次尝试)
  // ⚠️ 顺序即优先级: 排在前面的源, 其规则组元信息(描述/分类归属等)在合并时优先保留
  // 判断订阅是否还在维护: 仓库最近提交时间 / 订阅内 version 字段是否持续增长
  sources: [
    {
      // 主力源: 更新最频繁、覆盖最大, 放首位
      id: "linarm",
      name: "Lin-arm(主力)",
      url: "https://raw.githubusercontent.com/Lin-arm/GKD_subscription/main/dist/gkd.json5",
      fallbacks: ["https://cdn.jsdelivr.net/gh/Lin-arm/GKD_subscription@main/dist/gkd.json5"],
      enabled: true,
      note: "原主力订阅, 活跃维护, 规模最大(977应用)",
    },
    {
      id: "aoguai",
      name: "aoguai(默认订阅)",
      url: "https://cdn.jsdelivr.net/gh/aoguai/subscription@main/dist/gkd.json5",
      fallbacks: ["https://registry.npmmirror.com/@aoguai/subscription/latest/files/dist/gkd.json5"],
      enabled: true,
      note: "活跃维护",
    },
    {
      id: "ganlin",
      name: "甘霖",
      url: "https://cdn.jsdelivr.net/gh/ganlinte/GKD-subscription@main/dist/ganlin_gkd.json5",
      fallbacks: ["https://ghproxy.net/https://raw.githubusercontent.com/ganlinte/GKD-subscription/main/dist/ganlin_gkd.json5"],
      enabled: true,
      note: "活跃维护",
    },
    {
      id: "mengnian",
      name: "梦念逍遥",
      url: "https://cdn.jsdelivr.net/gh/MengNianxiaoyao/GKD-subscription@main/dist/gkd.json5",
      fallbacks: [],
      enabled: true,
      note: "活跃维护, 覆盖面较小, 作补充",
    },
  ],
}
